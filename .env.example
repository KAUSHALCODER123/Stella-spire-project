# Copy this file to .env and fill in your key. .env is gitignored.
OPENAI_API_KEY=sk-proj-your-key-here

# Run `python -m scripts.check_setup` to see which models your key can reach.
MODEL=gpt-5
MAX_TOKENS=16000

# Branding applied to every generated dossier.
AGENCY_NAME=Stellaspire
AGENCY_TAGLINE=We take hiring personally.
AGENCY_ACCENT=#1F3A5F

# Strip candidate contact details from the client-facing PDF.
ANONYMISE_BY_DEFAULT=true

# Durable storage for uploaded CVs and job descriptions (optional).
# Buckets must already exist. Without these the app writes to local disk only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-key-here
SUPABASE_BUCKET_RESUMES=resumes
SUPABASE_BUCKET_JDS=jds
